#!/bin/sh
# Block commits that would fail CI's `cargo fmt --all --check` gate — the exact
# check that let an unformatted main.rs slip into ec7d4ad.
# ponytail: fmt only (instant). clippy/test/build stay in the pre-PR + CI gate,
# too slow to run on every commit.
#
# Shared via core.hooksPath — enable once per clone:  git config core.hooksPath .githooks
if ! cargo fmt --all --check; then
  echo >&2
  echo "pre-commit: rustfmt check failed. Run 'cargo fmt --all', re-stage, and commit again." >&2
  exit 1
fi
