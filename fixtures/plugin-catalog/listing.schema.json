{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qrate.dvnl.work/plugins/schemas/listing.schema.json",
  "title": "qrate registry listing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "summary",
    "description",
    "categories",
    "license",
    "publisher",
    "repository",
    "screenshots",
    "featured",
    "releases"
  ],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 40 }
    },
    "license": { "$ref": "package.schema.json#/properties/license" },
    "publisher": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$" },
    "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$" },
    "homepage": { "type": "string", "pattern": "^https://" },
    "support": { "type": "string", "pattern": "^https://" },
    "icon": { "type": "string", "pattern": "^https://" },
    "screenshots": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "pattern": "^https://" }
    },
    "featured": { "type": "boolean" },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "api_version",
        "permissions",
        "published_at",
        "release_url",
        "artifact_url",
        "sha256",
        "bytes",
        "status"
      ],
      "properties": {
        "version": { "$ref": "package.schema.json#/properties/version" },
        "api_version": { "$ref": "package.schema.json#/properties/api_version" },
        "permissions": { "$ref": "package.schema.json#/properties/permissions" },
        "published_at": { "type": "string", "format": "date-time" },
        "release_url": { "type": "string", "pattern": "^https://github\\.com/.+/releases/tag/.+$" },
        "artifact_url": {
          "type": "string",
          "pattern": "^https://github\\.com/.+/releases/download/.+\\.zip$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
        "status": { "enum": ["active", "revoked"] },
        "revocation_reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "replacement_version": { "$ref": "package.schema.json#/properties/version" }
      }
    }
  }
}
