---
import { getReleases, latest, installationChoices, downloadLabel, humanSize, REPO } from '../lib/releases.js';

const rel = latest(await getReleases());
const assets = rel?.assets ?? [];
const { recommended, alternatives } = installationChoices(assets);
const sums = assets.find((asset) => asset.name === 'SHA256SUMS.txt');
const link = (asset) => `/thanks?a=${encodeURIComponent(asset.name)}`;
---

{
  recommended.length ? (
    <div class="qr-downloads not-content">
      <div class="qr-heading">Recommended for {rel.tag_name}</div>
      <div class="qr-choices">
        {recommended.map((asset) => (
          <div class="qr-choice">
            <div class="qr-platform">{asset.os}</div>
            <a href={link(asset)}>Download {downloadLabel(asset.name)}</a>
            <div class="qr-detail">{humanSize(asset.size)} · {asset.name}</div>
          </div>
        ))}
      </div>
      <p class="qr-note">Start with a base download. qrate offers to add PDF previews and the assistant when you need them.</p>
      {alternatives.length > 0 && (
        <details class="qr-more">
          <summary>Full, portable, and managed downloads</summary>
          <div class="qr-alternatives">
            {alternatives.map((asset) => (
              <div class="qr-alternative">
                <span>{asset.os} · {downloadLabel(asset.name)}</span>
                <a href={link(asset)}>{asset.name}</a>
                <span>{humanSize(asset.size)}</span>
              </div>
            ))}
          </div>
        </details>
      )}
      {sums && <div class="qr-checksums">Check a download against <a href={sums.browser_download_url}>SHA256SUMS.txt</a>.</div>}
    </div>
  ) : (
    <div class="qr-downloads not-content qr-empty">
      No published builds yet. See the <a href={`https://github.com/${REPO}/releases`}>Releases page</a>.
    </div>
  )
}

<style>
  .qr-downloads {
    border: 1px solid var(--sl-color-hairline);
    margin-block: 1.5rem;
    font-size: 0.9rem;
  }
  .qr-heading {
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-inline-code);
    font-weight: 600;
  }
  .qr-choices { display: grid; }
  .qr-choice { padding: 1rem; border-bottom: 1px solid var(--sl-color-hairline-light); }
  .qr-platform { font-weight: 600; margin-bottom: 0.35rem; }
  .qr-choice a { font-weight: 600; }
  .qr-detail { color: var(--sl-color-gray-3); font-size: 0.73rem; overflow-wrap: anywhere; margin-top: 0.35rem; }
  .qr-note, .qr-checksums { margin: 0; padding: 0.8rem 1rem; color: var(--sl-color-gray-2); }
  .qr-more { border-top: 1px solid var(--sl-color-hairline); }
  .qr-more summary { cursor: pointer; padding: 0.8rem 1rem; font-weight: 600; }
  .qr-alternatives { border-top: 1px solid var(--sl-color-hairline-light); }
  .qr-alternative { display: grid; gap: 0.15rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--sl-color-hairline-light); }
  .qr-alternative a { overflow-wrap: anywhere; }
  .qr-alternative span { color: var(--sl-color-gray-3); font-size: 0.78rem; }
  .qr-checksums { border-top: 1px solid var(--sl-color-hairline); font-size: 0.8rem; }
  .qr-empty { padding: 1rem; }
  @media (min-width: 42rem) {
    .qr-choices { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .qr-choice { border-bottom: 0; border-right: 1px solid var(--sl-color-hairline-light); }
    .qr-choice:last-child { border-right: 0; }
    .qr-alternative { grid-template-columns: 10rem minmax(0, 1fr) 5rem; align-items: center; }
  }
</style>
