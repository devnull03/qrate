---
const { permissions = [] } = Astro.props;
const descriptions: Record<string, string> = {
  net: 'Can make network requests after you grant access in qrate.',
};
---

{
  permissions.length ? (
    <ul class="m-0 list-none space-y-2 p-0">
      {permissions.map((permission) => (
        <li class="border border-rule-soft px-3 py-2 text-[13px]">
          <code>{permission}</code>
          <span class="ml-2 text-body">
            {descriptions[permission] ?? 'This permission is not described by this site version.'}
          </span>
        </li>
      ))}
    </ul>
  ) : (
    <p class="m-0 text-[13px] text-body">This plugin requests no optional permissions.</p>
  )
}
