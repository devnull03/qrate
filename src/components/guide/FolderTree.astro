---
// A folder tree, one entry per line. Each leading '>' is one level deeper; a trailing / marks a
// folder. Markers rather than spaces, because MDX re-indents multi-line attribute values.
interface Props {
  items: string[];
  label?: string;
}
const { items, label } = Astro.props;
const lines = items.map((raw) => {
  const name = raw.replace(/^>+/, '');
  return { depth: raw.length - name.length, name: name.replace(/\/$/, ''), folder: name.endsWith('/') };
});
---

<div class="min-w-[220px] border border-rule bg-paper px-3 py-2.5 font-mono text-[11.5px] leading-[1.75] text-ink">
  {label && <div class="mb-1 text-[10.5px] uppercase tracking-[0.08em] text-dim">{label}</div>}
  {
    lines.map((l) => (
      <div style={`padding-left: ${l.depth * 16}px`} class={l.folder ? 'font-medium' : 'text-body'}>
        <span class={l.folder ? 'text-accent' : 'text-faint'}>{l.folder ? '▪ ' : '· '}</span>
        {l.name}
      </div>
    ))
  }
</div>
