---
// Overrides Starlight's SiteTitle: the real qrate mark instead of a plain
// wordmark, and it links to /docs rather than the marketing home, so there is
// always a way back to the docs index from any page.
import Logo from './Logo.astro';
---

<a href="/docs" class="site-title sl-flex">
  <Logo size={19} id="docs" />
  <span translate="no">qrate</span>
  <span class="qr-badge">docs</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 9px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .qr-badge {
    font-family: var(--sl-font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    border: 1px solid var(--sl-color-hairline);
    padding: 0.2em 0.4em;
  }
</style>
