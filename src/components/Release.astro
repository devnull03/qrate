---
import { marked } from 'marked';
import { humanSize, formatDate, platformOf } from '../lib/releases.js';

const { release, latest = false } = Astro.props;

// Release bodies are authored by the repo owner, so rendering their markdown is
// trusted content. (Add sanitize-html here if that assumption ever changes.)
const notesHtml = release.body ? marked.parse(release.body) : '';
const assets = release.assets ?? [];
const tag = release.prerelease ? 'pre-release' : latest ? 'latest' : 'release';

// /thanks is built from the newest release alone, so only its rows may go there.
// An older tag's filename would miss the lookup and fall back to the current
// build, handing over a different file than the row names. Those stay direct,
// and so does SHA256SUMS.txt, which has no install steps to show.
const thanksLink = (name) =>
  latest && platformOf(name) ? `/thanks?a=${encodeURIComponent(name)}` : null;
---

<article class="grid grid-cols-1 border-b border-rule md:grid-cols-[220px_1fr]">
  <div class="gut border-b border-rule py-[22px] md:border-b-0 md:border-r md:px-6 md:py-[30px]">
    <div class="mb-2.5 flex flex-wrap items-center gap-2">
      <span class="font-mono text-[18px] font-semibold tracking-[-0.02em]">{release.tag_name}</span>
      <span
        class:list={[
          'px-[7px] py-0.5 font-mono text-[9.5px] font-semibold uppercase tracking-[0.08em]',
          release.prerelease
            ? 'text-rust shadow-[inset_0_0_0_1px_var(--rust)]'
            : 'bg-accent text-on-accent',
        ]}>{tag}</span
      >
    </div>
    <div class="font-mono text-xs text-dim">{formatDate(release.published_at)}</div>
    <div class="mt-3.5 break-all font-mono text-xs leading-[1.7] text-faint">
      {release.target_commitish} @ {release.tag_name}
    </div>
  </div>

  <div class="gut min-w-0 py-[22px] md:px-[26px] md:py-[30px]">
    <div class="mb-3 text-[18px] font-semibold leading-[1.3] tracking-[-0.02em]">
      {release.name || release.tag_name}
    </div>
    {notesHtml && <div class="notes text-[13.5px] leading-[1.65] text-body" set:html={notesHtml} />}

    {
      assets.length > 0 && (
        <div class="mt-[18px] border-t border-rule">
          {assets.map((a) => (
            <div class="flex items-center justify-between gap-4 border-b border-rule-soft py-[9px] font-mono text-[12.5px]">
              <span class="break-all">{a.name}</span>
              <span class="flex shrink-0 items-center gap-4 text-dim">
                <span>{humanSize(a.size)}</span>
                <a href={thanksLink(a.name) ?? a.browser_download_url} class="text-accent">
                  download
                </a>
              </span>
            </div>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  /* Markdown notes, restyled into the design's "+ line" list. The gutter is
     absolute, not a grid column. A grid would promote every inline text node
     in the item to its own row. */
  .notes :global(:first-child) {
    margin-top: 0;
  }

  .notes :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .notes :global(li) {
    position: relative;
    padding-left: 24px;
    margin-bottom: 6px;
  }

  .notes :global(li)::before {
    content: '+';
    position: absolute;
    left: 0;
    top: 1px;
    color: var(--accent);
    font: 500 12px var(--font-mono);
  }

  .notes :global(li ul) {
    margin-top: 6px;
  }

  .notes :global(li li)::before {
    content: '·';
  }

  .notes :global(strong) {
    color: var(--ink);
  }

  .notes :global(h1),
  .notes :global(h2),
  .notes :global(h3) {
    font: 600 15px var(--font-sans);
    color: var(--ink);
    margin: 18px 0 8px;
  }

  .notes :global(a) {
    color: var(--accent);
  }

  .notes :global(code) {
    font: 400 12.5px var(--font-mono);
  }

  .notes :global(pre) {
    background: var(--ink);
    color: rgba(247, 244, 238, 0.85);
    padding: 12px 14px;
    overflow-x: auto;
  }
</style>
