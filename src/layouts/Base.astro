---
// Importing the stylesheet (rather than <link href="...">) lets Astro fingerprint
// it and rewrite the URL under `base`, so it never 404s on the project subpath.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'qrate',
  description = 'One file holds the whole catalogue. A desktop editor for collection metadata, on macOS, Windows and Linux.',
  current = '',
  version = '',
} = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Applied before paint so the accent never flashes the default theme.
      window.QRATE_THEMES = [
        ['qrate-light', 'Qrate Light'],
        ['qrate-dark', 'Qrate Dark'],
        ['gruvbox-light', 'Gruvbox Light'],
        ['gruvbox-dark', 'Gruvbox Dark'],
        ['everforest-light', 'Everforest Light'],
        ['everforest-dark', 'Everforest Dark'],
      ];
      document.documentElement.dataset.theme =
        localStorage.getItem('qrate-theme') || 'qrate-light';
    </script>
  </head>
  <body>
    <Nav current={current} />
    <main class="overflow-x-clip">
      <slot />
    </main>
    <Footer version={version} />

    <script is:inline>
      (() => {
        const themes = window.QRATE_THEMES;
        const root = document.documentElement;
        const btn = document.getElementById('theme-btn');
        const name = document.getElementById('theme-name');
        const show = () => {
          const hit = themes.find((t) => t[0] === root.dataset.theme);
          name.textContent = (hit || themes[0])[1];
        };
        btn.addEventListener('click', () => {
          const i = themes.findIndex((t) => t[0] === root.dataset.theme);
          const next = themes[(i + 1) % themes.length][0];
          root.dataset.theme = next;
          localStorage.setItem('qrate-theme', next);
          show();
        });
        show();
      })();
    </script>
  </body>
</html>
