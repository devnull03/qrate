---
// Importing the stylesheet (rather than <link href="...">) lets Astro fingerprint
// it and rewrite the URL under `base`, so it never 404s on the project subpath.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'qrate',
  description = 'Free, open-source desktop software for collection metadata. Catalogue archives, libraries and museums offline: one file per project, no server.',
  current = '',
  version = '',
  noindex = false,
} = Astro.props;

// Absolute URLs: scrapers do not resolve relative ones. `build.format: 'file'`
// makes the prerender pathname /changelog.html, but the served URL is
// /changelog — strip the extension so the canonical points at what people link.
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''),
  Astro.site
);
const ogImage = new URL('/og.png', Astro.site);

// Cloudflare Web Analytics: cookieless, no cross-site identifier, and it only
// exists when CF_BEACON_TOKEN is set at build time. The docs pages get the same
// tag from astro.config.mjs, because Starlight does not render this layout.
const beacon = import.meta.env.CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="qrate" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The qrate logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0022ff" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Applied before paint so the accent never flashes the default theme.
      window.QRATE_THEMES = [
        ['qrate-light', 'Qrate Light'],
        ['qrate-dark', 'Qrate Dark'],
        ['gruvbox-light', 'Gruvbox Light'],
        ['gruvbox-dark', 'Gruvbox Dark'],
        ['everforest-light', 'Everforest Light'],
        ['everforest-dark', 'Everforest Dark'],
      ];
      document.documentElement.dataset.theme =
        localStorage.getItem('qrate-theme') || 'qrate-light';
    </script>

    {
      beacon && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beacon })}
        />
      )
    }
  </head>
  <body>
    <Nav current={current} />
    <main class="overflow-x-clip">
      <slot />
    </main>
    <Footer version={version} />

    <script is:inline>
      (() => {
        const themes = window.QRATE_THEMES;
        const root = document.documentElement;
        const btn = document.getElementById('theme-btn');
        const name = document.getElementById('theme-name');
        const show = () => {
          const hit = themes.find((t) => t[0] === root.dataset.theme);
          name.textContent = (hit || themes[0])[1];
        };
        btn.addEventListener('click', () => {
          const i = themes.findIndex((t) => t[0] === root.dataset.theme);
          const next = themes[(i + 1) % themes.length][0];
          root.dataset.theme = next;
          localStorage.setItem('qrate-theme', next);
          show();
        });
        show();
      })();
    </script>
  </body>
</html>
