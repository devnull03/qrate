---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getReleases, latest } from '../../lib/releases.js';
import { getGuides, readingMinutes, formatDate, type Guide } from '../../lib/guides';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide, i) => ({
    params: { slug: guide.id },
    props: { guide, newer: guides[i - 1], older: guides[i + 1] },
  }));
}

const { guide, newer, older } = Astro.props as { guide: Guide; newer?: Guide; older?: Guide };
const { Content } = await render(guide);
const { title, description, published, updated, tags, related } = guide.data;
const rel = latest(await getReleases());
---

<Base title={`qrate · ${title}`} description={description} current="guides" version={rel?.tag_name}>
  <section class="gut border-b border-rule py-[30px] md:pb-[46px] md:pt-[54px]">
    <div class="mx-auto max-w-[720px]">
      <a href="/guides" class="eyebrow">← How-to guides</a>
      <h1
        class="m-0 mb-3.5 mt-[18px] text-[32px] font-semibold leading-[1.04] tracking-[-0.035em] md:text-[46px]"
      >
        {title}
      </h1>
      <p class="m-0 text-[15px] leading-[1.6] text-body">{description}</p>
      <div class="mt-5 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[11px] uppercase tracking-[0.08em] text-faint">
        <span>By the qrate team</span>
        <span>{formatDate(published)}</span>
        {updated && <span>Updated {formatDate(updated)}</span>}
        <span>{readingMinutes(guide.body)} min read</span>
        {tags.map((t) => <span class="text-dim">#{t}</span>)}
      </div>
    </div>
  </section>

  <article class="gut py-[30px] md:py-[44px]">
    <div class="guide mx-auto max-w-[720px]">
      <Content />
    </div>

    {
      related.length > 0 && (
        <aside class="mx-auto mt-10 max-w-[720px] border-l-2 border-accent py-1 pl-4">
          <div class="mb-1 font-mono text-[11px] uppercase tracking-[0.08em] text-dim">In the docs</div>
          <ul class="m-0 flex list-none flex-col gap-1 p-0 text-[14px]">
            {related.map((r) => (
              <li>
                <a href={r.href} class="text-accent">{r.label}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>

  <nav class="gut border-t border-rule">
    <div class="mx-auto grid max-w-[720px] grid-cols-1 gap-px md:grid-cols-2">
      {
        [
          [older, 'Previous guide', ''],
          [newer, 'Next guide', 'md:text-right'],
        ].map(([g, label, align]) =>
          g ? (
            <a href={`/guides/${(g as Guide).id}`} class={`py-5 hover:no-underline ${align}`}>
              <div class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{label}</div>
              <div class="mt-1 text-[16px] font-semibold text-ink">{(g as Guide).data.title}</div>
            </a>
          ) : (
            <div class="hidden md:block" />
          )
        )
      }
    </div>
  </nav>
</Base>

<style is:global>
  .guide > :first-child {
    margin-top: 0;
  }

  .guide h2 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 36px 0 10px;
    scroll-margin-top: 20px;
  }

  .guide h3 {
    font-size: 17px;
    font-weight: 600;
    margin: 24px 0 6px;
  }

  .guide p,
  .guide li {
    font-size: 15px;
    line-height: 1.7;
    color: var(--body);
  }

  .guide p {
    margin: 0 0 14px;
  }

  .guide ul,
  .guide ol {
    margin: 0 0 14px;
    padding-left: 22px;
  }

  .guide ul {
    list-style: square;
  }

  .guide ol {
    list-style: decimal;
  }

  .guide li {
    margin-bottom: 6px;
  }

  .guide li::marker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .guide a {
    color: var(--accent);
  }

  .guide strong {
    color: var(--ink);
    font-weight: 600;
  }

  .guide code {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
    background: var(--rule-soft);
    padding: 1px 4px;
  }

  .guide pre {
    margin: 0 0 16px;
    padding: 14px 16px;
    overflow-x: auto;
    background: #17140f;
    font-size: 13px;
    line-height: 1.6;
  }

  .guide pre code {
    background: none;
    padding: 0;
    color: #f2ede4;
  }

  .guide blockquote {
    margin: 0 0 14px;
    padding: 8px 0 8px 14px;
    border-left: 2px solid var(--accent);
  }

  .guide blockquote p {
    margin: 0;
    font-size: 14px;
  }

  .guide table {
    width: 100%;
    margin: 0 0 16px;
    border-collapse: collapse;
    font-size: 13.5px;
    display: block;
    overflow-x: auto;
  }

  .guide th,
  .guide td {
    border: 1px solid var(--rule);
    padding: 6px 10px;
    text-align: left;
    vertical-align: top;
    color: var(--body);
  }

  .guide th {
    color: var(--ink);
    font-weight: 600;
  }

  .guide img {
    max-width: 100%;
    height: auto;
  }
</style>
