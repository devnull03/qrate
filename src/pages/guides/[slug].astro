---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/guide.css';
import { getReleases, latest } from '../../lib/releases.js';
import { getGuides, readingMinutes, formatDate, type Guide } from '../../lib/guides';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide, i) => ({
    params: { slug: guide.id },
    props: { guide, previous: guides[i - 1], next: guides[i + 1] },
  }));
}

const { guide, previous, next } = Astro.props as { guide: Guide; previous?: Guide; next?: Guide };
const { Content } = await render(guide);
const { title, description, published, updated, tags, related, qrateVersion } = guide.data;
const rel = latest(await getReleases());
const current = rel?.tag_name?.replace(/^v/, '');
const url = new URL(`/guides/${guide.id}`, Astro.site).href;
const team = { '@type': 'Organization', name: 'qrate', url: Astro.site?.href };
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: published.toISOString().slice(0, 10),
    dateModified: (updated ?? published).toISOString().slice(0, 10),
    author: team,
    publisher: team,
    mainEntityOfPage: url,
    about: { '@type': 'SoftwareApplication', name: 'qrate', softwareVersion: qrateVersion },
    keywords: tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Guides', item: new URL('/guides', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  },
];
---

<Base title={`qrate · ${title}`} description={description} current="guides" version={rel?.tag_name}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="gut border-b border-rule py-[30px] md:pb-[46px] md:pt-[54px]">
    <div class="mx-auto max-w-[720px]">
      <a href="/guides" class="eyebrow">← How-to guides</a>
      <h1
        class="m-0 mb-3.5 mt-[18px] text-[32px] font-semibold leading-[1.04] tracking-[-0.035em] md:text-[46px]"
      >
        {title}
      </h1>
      <p class="m-0 text-[15px] leading-[1.6] text-body">{description}</p>
      <div class="mt-5 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[11px] uppercase tracking-[0.08em] text-faint">
        <span>By the qrate team</span>
        <span>{formatDate(published)}</span>
        {updated && <span>Updated {formatDate(updated)}</span>}
        <span>{readingMinutes(guide.body)} min read</span>
        {tags.map((t) => <span class="text-dim">#{t}</span>)}
      </div>
      <p class="m-0 mt-4 border-l-2 border-accent pl-3 text-[13px] leading-[1.6] text-body">
        Written for <strong class="font-semibold text-ink">qrate {qrateVersion}</strong>.
        {
          current && current !== qrateVersion
            ? ` qrate is now at ${current}, so a menu or label may have moved. The docs describe the current version.`
            : ' If a menu or label has moved since, the docs describe the current version.'
        }
      </p>
    </div>
  </section>

  <article class="gut py-[30px] md:py-[44px]">
    <div class="guide mx-auto max-w-[720px]">
      <Content />
    </div>

    {
      related.length > 0 && (
        <aside class="mx-auto mt-10 max-w-[720px] border-l-2 border-accent py-1 pl-4">
          <div class="mb-1 font-mono text-[11px] uppercase tracking-[0.08em] text-dim">In the docs</div>
          <ul class="m-0 flex list-none flex-col gap-1 p-0 text-[14px]">
            {related.map((r) => (
              <li>
                <a href={r.href} class="text-accent">{r.label}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>

  <nav class="gut border-t border-rule">
    <div class="mx-auto grid max-w-[720px] grid-cols-1 gap-px md:grid-cols-2">
      {
        [
          [previous, 'Previous', ''],
          [next, 'Next', 'md:text-right'],
        ].map(([g, label, align]) =>
          g ? (
            <a href={`/guides/${(g as Guide).id}`} class={`py-5 hover:no-underline ${align}`}>
              <div class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{label}</div>
              <div class="mt-1 text-[16px] font-semibold text-ink">{(g as Guide).data.title}</div>
            </a>
          ) : (
            <div class="hidden md:block" />
          )
        )
      }
    </div>
  </nav>
</Base>
