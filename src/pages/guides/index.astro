---
import Base from '../../layouts/Base.astro';
import { getReleases, latest } from '../../lib/releases.js';
import { getGuides, readingMinutes, formatDate } from '../../lib/guides';

const guides = await getGuides();
const rel = latest(await getReleases());
---

<Base
  title="qrate · how-to guides"
  description="Step-by-step guides for archivists using qrate: build an archival hierarchy from folders, link scans to records, clean a spreadsheet for Islandora, and export your catalogue."
  current="guides"
  version={rel?.tag_name}
>
  <section class="gut border-b border-rule py-[30px] md:pb-[46px] md:pt-[54px]">
    <div class="eyebrow">How-to guides</div>
    <h1
      class="m-0 mb-3.5 mt-[18px] max-w-[720px] text-[32px] font-semibold leading-[1.04] tracking-[-0.035em] md:text-[46px]"
    >
      Real cataloguing tasks, start to finish.
    </h1>
    <p class="m-0 max-w-[560px] text-[15px] leading-[1.6] text-body">
      Each guide takes one job an archivist actually has, and walks through it in qrate. For what a
      single menu or setting does, see the <a href="/docs" class="text-accent">docs</a>.
    </p>
  </section>

  <section class="gut py-[30px] md:py-[44px]">
    {
      guides.length === 0 ? (
        <p class="text-body">No guides yet.</p>
      ) : (
        <ul class="m-0 grid list-none grid-cols-1 gap-px border border-rule bg-rule p-0 md:grid-cols-2">
          {guides.map((g) => (
            <li class="bg-paper">
              <a href={`/guides/${g.id}`} class="flex h-full flex-col gap-2 p-5 hover:no-underline md:p-6 [&:hover_h2]:underline">
                <div class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">
                  {formatDate(g.data.published)} · {readingMinutes(g.body)} min read
                  {g.data.draft && ' · draft'}
                </div>
                <h2 class="m-0 text-[20px] font-semibold leading-[1.2] text-ink">{g.data.title}</h2>
                <p class="m-0 text-[14px] leading-[1.6] text-body">{g.data.description}</p>
                {g.data.tags.length > 0 && (
                  <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
                    {g.data.tags.map((t) => (
                      <span class="border border-rule px-1.5 py-0.5 font-mono text-[10.5px] text-dim">{t}</span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
