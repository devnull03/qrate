---
// Google's file chooser, which has to run in a browser. `drive.file` reaches
// only files qrate created *or* files the user picked through a Picker built
// with the same Cloud project number — so without this page qrate can never
// write to a spreadsheet the user already owns.
//
// Standalone rather than on the site layout: it exists for about four seconds
// and a nav bar during a consent flow is noise.

// The Cloud project number. `setAppId` is the load-bearing line — a Picker
// without it grants nothing, and qrate gets a 404 on the write instead.
const APP_ID = '805791669854';

// A browser API key, safe to ship in the page, restricted by HTTP referrer to
// this site. Create it in the same Cloud project; until it is set the page
// says so rather than failing silently.
const PICKER_API_KEY = '';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Choose a spreadsheet — qrate</title>
    <style>
      body {
        margin: 0;
        display: grid;
        place-items: center;
        min-height: 100vh;
        background: #ece7de;
        color: #17140f;
        font: 15px/1.6 ui-sans-serif, system-ui, sans-serif;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <p id="msg">Opening your Drive…</p>

    <script is:inline define:vars={{ APP_ID, PICKER_API_KEY }}>
      // The token, nonce and loopback port arrive in the fragment, which
      // browsers never send to a server.
      const p = new URLSearchParams(location.hash.slice(1));
      // Don't leave an access token sitting in browser history.
      history.replaceState(null, '', location.pathname);

      const msg = document.getElementById('msg');
      const fail = (text) => {
        msg.textContent = text;
      };

      if (!PICKER_API_KEY) {
        fail('This site has no Google Picker API key configured yet.');
      } else if (!p.get('token') || !p.get('state') || !p.get('port')) {
        fail('Open this page from qrate — it needs details qrate passes in the link.');
      } else {
        const s = document.createElement('script');
        s.src = 'https://apis.google.com/js/api.js';
        s.onerror = () => fail("Couldn't load Google's file chooser.");
        s.onload = () =>
          gapi.load('picker', () => {
            new google.picker.PickerBuilder()
              .setAppId(APP_ID)
              .setOAuthToken(p.get('token'))
              .setDeveloperKey(PICKER_API_KEY)
              .addView(new google.picker.DocsView(google.picker.ViewId.SPREADSHEETS))
              .setCallback((data) => {
                if (data.action === google.picker.Action.CANCEL) {
                  fail('Nothing chosen. You can close this window.');
                  return;
                }
                if (data.action !== google.picker.Action.PICKED) return;
                msg.textContent = 'Handing it back to qrate…';
                // qrate rejects the reply unless `state` comes back unchanged.
                location.replace(
                  `http://127.0.0.1:${encodeURIComponent(p.get('port'))}/` +
                    `?fileId=${encodeURIComponent(data.docs[0].id)}` +
                    `&state=${encodeURIComponent(p.get('state'))}`,
                );
              })
              .build()
              .setVisible(true);
          });
        document.head.appendChild(s);
      }
    </script>
  </body>
</html>
