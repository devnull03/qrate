---
import Base from '../layouts/Base.astro';
import AppWindow from '../components/AppWindow.astro';
import { getReleases, latest, platformOf, REPO } from '../lib/releases.js';

const releases = await getReleases();
const rel = latest(releases);

// One installer per platform, for the hero button the client picks by OS.
// The order is also the server-rendered fallback order, for no-JS and for
// visitors on a platform with no build.
const ORDER = ['macOS', 'Windows', 'Linux'];
const byOs = {};
for (const a of rel?.assets ?? []) {
  const os = platformOf(a.name);
  if (os && !byOs[os]) byOs[os] = a.browser_download_url;
}
const available = ORDER.filter((os) => byOs[os]);
const fallback = available[0] ?? null;
const others = available.filter((os) => os !== fallback);

// One card per screen of the app. `shot` is a dark-theme capture of that screen;
// the four that have none render as text cards rather than as a dashed
// placeholder box. Drop a file in public/shots and name it here to fill one in:
// /01 wants table-full, /02 problems, /04 gallery-full, /05 details-panel.
const screens = [
  {
    num: '/01',
    title: 'Table view',
    body: 'The core screen. A virtualized grid with a pinned row-number column, movable and resizable columns, undo, redo, cut, copy, paste, and find and replace on Ctrl+F.',
    meta: 'column layout persists per project',
    wide: true,
  },
  {
    num: '/02',
    title: 'Problems panel',
    body: 'Errors, warnings and notes counted on the status bar, filterable by source, click to jump to the cell. A Fixes menu offers the concrete replacement.',
    meta: 'dates · spelling · LCSH · GeoNames · Wikidata · broken links',
    wide: true,
  },
  {
    num: '/03',
    title: 'New project wizard',
    body: 'Name, files, link, columns, create. Point at a CSV or Sheet and a folder, match rows to files by filename or a pattern, then derive the columns or load a config.',
    meta: 'five steps · matched N of M files',
  },
  {
    num: '/04',
    title: 'Gallery view',
    body: "The same records as thumbnails, sharing the grid's filter and selection. Ctrl+2, or the view switcher tabs.",
    meta: 'built for photo-heavy collections',
  },
  {
    num: '/05',
    title: 'Details panel',
    body: "The selected row's photo and every field as an editable list. Select several rows and one edit writes the same value down the selection.",
    meta: 'left dock',
  },
  {
    num: '/06',
    title: 'Fullscreen viewer',
    body: 'Click a preview for a zoom and pan overlay, with page navigation and in-document find. Images, PDF, video frames, audio, Office, eBook and text.',
    meta: 'PDFium · ffmpeg · type icon fallback',
  },
  {
    num: '/07',
    title: 'Agent panel',
    body: 'A read-only bridge. One tab logs what an external agent read or was refused, the other is where it runs. Nothing writes a cell until the archivist clicks it.',
    meta: 'right dock · off unless you enable it',
  },
  {
    num: '/08',
    title: 'Export',
    body: 'CSV, JSON-LD and CSL-JSON whenever you want them. Google Sheets export and sync stay hidden until you opt in, and authenticate on-device.',
    meta: 'File ▸ Export · loopback + PKCE OAuth',
  },
];

const plugins = [
  {
    mark: 'Is',
    dark: true,
    tag: 'available',
    tagClass: 'text-rust',
    name: 'Islandora',
    body: 'Holds columns to the vocabularies your Islandora site publishes, and offers those terms while you type. Terms are checked where they live, so a hundred thousand of them cost the same as ten.',
    repo: 'devnull03/qrate-islandora-plugin',
    action: 'install →',
    href: 'https://github.com/devnull03/qrate-islandora-plugin',
  },
  {
    mark: '{ }',
    tag: 'template',
    tagClass: 'text-dim',
    name: 'Plugin template',
    body: 'Where a new plugin starts: a worked example plus type definitions for every capability the host offers, so your editor tells you what a plugin can and cannot do.',
    repo: 'devnull03/qrate-plugin-template',
    action: 'start here →',
    href: 'https://github.com/devnull03/qrate-plugin-template',
  },
  {
    mark: '↯',
    tag: 'yours',
    tagClass: 'text-dim',
    name: 'Write your own',
    body: 'Validation, suggestions, column configuration, menu items and status or title bar entries with inline markup. No io, no os, no package: a plugin only reaches what qrate hands it.',
    repo: 'Extensions ▸ Open Plugins Folder',
    action: 'read the docs →',
    href: 'https://github.com/devnull03/qrate-plugin-template#readme',
  },
];

const mess = [
  ['metadata.xlsx', '3 conflicting copies'],
  ['scans/', '14,203 files, no links'],
  ['naming-rules.docx', 'last opened 2023'],
  ['email thread', '61 replies'],
];
---

<Base
  title="qrate · collection metadata editor for archives"
  description="A free, open-source desktop app for cataloguing collections. Edit metadata in a spreadsheet grid, link scans, check fields. macOS, Windows and Linux."
  current=""
  version={rel?.tag_name}
>
  <section class="grid grid-cols-1 border-b border-rule-nav md:grid-cols-2">
    <div class="gut border-rule-nav py-[34px] md:border-r md:pb-[60px] md:pt-16">
      <div class="eyebrow mb-[22px] flex items-center gap-[9px]">
        <span class="h-px w-5 bg-accent"></span>Open source collections software · desktop · AGPL-3.0
      </div>
      <h1
        class="m-0 mb-[14px] text-[33px] font-semibold leading-[1.05] tracking-[-0.035em] md:mb-5 md:text-[52px] md:leading-[1.03]"
      >
        One file holds the whole catalogue.
      </h1>
      <p class="m-0 mb-7 max-w-[440px] text-[14.5px] leading-[1.6] text-body md:text-[16px]">
        Collection metadata, notes and every linked scan, in one <span
          class="font-mono text-[13px] text-ink md:text-[14.5px]">.qrate</span
        > file on your own disk. No account, no server, works offline.
      </p>
      <div class="mb-[34px] flex flex-col items-stretch gap-2 md:flex-row md:items-center md:gap-2.5">
        <a
          id="dl-primary"
          href={fallback ? byOs[fallback] : `/docs/install`}
          class="bg-ink px-5 py-3 text-center text-[14px] font-medium text-paper"
          >{fallback ? `Download for ${fallback}` : 'Get started'}</a
        >
        <a
          id="dl-others"
          href="/docs/install"
          class="border border-[rgba(23,20,15,.22)] px-[18px] py-3 text-center text-[14px] font-medium"
          >{others.length ? others.join(' · ') : 'All platforms'}</a
        >
      </div>
      <div class="flex border-t border-rule-nav">
        <div class="flex-1 py-3.5">
          <div class="font-mono text-xl font-semibold tracking-[-0.02em]">1 file</div>
          <div class="text-xs text-dim">per project</div>
        </div>
        <div class="flex-1 border-l border-rule-nav py-3.5 pl-[18px]">
          <div class="font-mono text-xl font-semibold tracking-[-0.02em]">4</div>
          <div class="text-xs text-dim">export formats</div>
        </div>
        <div class="flex-1 border-l border-rule-nav py-3.5 pl-[18px]">
          <div class="font-mono text-xl font-semibold tracking-[-0.02em]">0</div>
          <div class="text-xs text-dim">accounts required</div>
        </div>
      </div>
    </div>

    <div class="gut flex flex-col justify-center gap-2.5 bg-wash py-5 md:p-[34px]">
      <!-- The fake window has fixed column widths; let it scroll rather than
           widen the page on a phone. -->
      <div class="max-w-full overflow-x-auto">
        <AppWindow />
      </div>
      <div class="font-mono text-[10.5px] text-dim">
        ↑ rendered live in <span class="text-ink" id="theme-echo">Qrate Light</span> · every theme
        that ships with the app
      </div>
    </div>
  </section>

  {/* The "In use at" logo band. Commented out, not deleted: empty placeholder
      boxes read as a broken page rather than as social proof. Uncomment and
      swap the strings for real institution names once there are some.

  <section
    class="gut flex flex-col items-start gap-3 border-b border-rule py-[22px] md:flex-row md:items-center md:gap-[26px]"
  >
    <div class="eyebrow whitespace-nowrap text-faint">In use at</div>
    <div class="grid w-full flex-1 grid-cols-2 gap-3 md:grid-cols-4">
      {
        ['[ institution name ]', '[ university library ]', '[ community archive ]', '[ museum ]'].map(
          (s) => (
            <div class="border border-dashed border-[rgba(23,20,15,.26)] px-3 py-[11px] font-mono text-[11px] text-[rgba(23,20,15,.4)]">
              {s}
            </div>
          ),
        )
      }
    </div>
  </section>
  */}

  <section class="gut flex flex-col items-center gap-4 py-[34px] md:pb-14 md:pt-16">
    <div class="flex flex-col items-baseline gap-2 self-stretch md:flex-row md:gap-3.5">
      <div class="eyebrow whitespace-nowrap md:pt-2">The window</div>
      <h2 class="m-0 max-w-[560px] text-2xl font-semibold leading-[1.1] md:text-[32px]">
        Grid, preview and problems, docked together.
      </h2>
    </div>
    <div class="shot w-[900px] max-w-full">
      <img
        src="/shots/light-table.webp"
        width="1200"
        height="790"
        alt="qrate collection metadata editor: record details, spreadsheet grid and validation problems panel"
      />
    </div>
    <div class="flex w-[900px] max-w-full justify-between font-mono text-[11px] text-dim">
      <span>Details · grid · problems, docked in one window</span><span>Qrate Light</span>
    </div>
  </section>

  <section class="gut border-t border-rule py-[26px] md:pb-[60px] md:pt-14" id="features">
    <div class="mb-4 flex items-baseline justify-between gap-3 md:mb-[26px]">
      <div class="flex flex-col items-baseline gap-2 md:flex-row md:gap-3.5">
        <div class="eyebrow whitespace-nowrap">Features</div>
        <h2 class="m-0 text-[22px] font-semibold leading-[1.1] md:text-[32px]">
          Every screen, and what it is for.
        </h2>
      </div>
      <span class="whitespace-nowrap font-mono text-[10.5px] text-faint md:hidden">swipe →</span>
    </div>

    {/* One row of snap-scrolled cards on a phone, a 6-column mosaic above it. */}
    <div
      id="screen-rail"
      class="flex snap-x snap-mandatory gap-3 overflow-x-auto pb-1 md:grid md:grid-cols-6 md:gap-px md:overflow-visible md:border md:border-rule md:bg-rule md:pb-0"
    >
      {
        screens.map((s) => (
          <article
            class:list={[
              'flex shrink-0 basis-[300px] snap-center flex-col border border-rule bg-paper md:basis-auto md:border-0',
              s.wide ? 'md:col-span-3' : 'md:col-span-2',
            ]}
          >
            {s.shot && (
              <div class="border-b border-rule bg-ink p-3 md:px-[26px] md:pb-5 md:pt-[26px]">
                <div
                  class:list={[
                    'flex h-[170px] items-center justify-center',
                    s.wide ? 'md:h-[340px]' : 'md:h-[265px]',
                  ]}
                >
                  <img
                    src={s.shot}
                    alt={s.alt}
                    loading="lazy"
                    decoding="async"
                    class="block h-auto max-h-full w-auto max-w-full border border-[rgba(247,244,238,.14)] [filter:var(--shot-filter)]"
                  />
                </div>
                <div class="mt-2 font-mono text-[10.5px] text-[rgba(247,244,238,.45)]">
                  {s.caption}
                </div>
              </div>
            )}
            <div class="flex flex-1 flex-col p-[18px] pb-[22px] md:px-[30px] md:pb-9 md:pt-[30px]">
              <div class="mb-2 font-mono text-[11px] font-semibold text-accent md:mb-2.5">
                {s.num}
              </div>
              <h3 class="m-0 mb-2 text-[21px] font-bold uppercase leading-[1.05] tracking-[-0.035em] md:mb-2.5 md:text-2xl">
                {s.title}
              </h3>
              <p class="m-0 mb-3 text-[13px] leading-[1.6] text-body md:text-[14px]">{s.body}</p>
              <div class="mt-auto font-mono text-[11.5px] font-medium text-ink md:text-xs">
                {s.meta}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {/* Which card the phone carousel is on. Server-rendered on the first dot,
        which is where an unscrolled rail already sits, so no-JS reads right. */}
    <div class="mt-4 flex justify-center gap-1.5 md:hidden" id="screen-dots">
      {
        screens.map((_, i) => (
          <span
            class="h-0.5 w-2.5 bg-[rgba(23,20,15,.25)]"
            style={i === 0 ? 'width:18px;background:var(--accent)' : undefined}
          />
        ))
      }
    </div>
  </section>

  <section
    class="gut grid grid-cols-1 items-center gap-5 border-b border-rule py-5 md:grid-cols-2 md:gap-10 md:pb-[60px] md:pt-14"
  >
    <div class="shot">
      <img
        src="/shots/light-gallery.webp"
        width="1200"
        height="790"
        loading="lazy"
        decoding="async"
        alt="qrate gallery view of a digitised collection with an item preview open"
      />
    </div>
    <div>
      <div class="eyebrow mb-3.5">Gallery view</div>
      <h2 class="m-0 mb-3 text-2xl font-semibold leading-[1.1] md:text-[30px]">
        Look at the thing you are describing.
      </h2>
      <p class="m-0 mb-4 max-w-[400px] text-[14.5px] leading-[1.65] text-body">
        Switch the grid for a gallery, open an item full size, and keep editing its fields beside
        it. Images, documents, audio and video preview in place.
      </p>
      <div class="font-mono text-xs leading-[1.9] text-ink">
        JPG · TIFF · PDF · WAV · MP4
        <div class="text-dim">PDF via PDFium · video frames via ffmpeg</div>
      </div>
    </div>
  </section>

  <section class="gut border-b border-rule py-[26px] md:pb-[60px] md:pt-14" id="plugins">
    <div class="mb-2 flex flex-col items-baseline justify-between gap-2 md:flex-row md:gap-5">
      <div class="flex flex-col items-baseline gap-2 md:flex-row md:gap-3.5">
        <div class="eyebrow whitespace-nowrap">/05 Plugins</div>
        <h2 class="m-0 text-2xl font-semibold leading-[1.1] md:text-[32px]">
          Extend it from a folder you control.
        </h2>
      </div>
      <span class="whitespace-nowrap font-mono text-xs text-dim">Help ▸ Open Plugins Folder</span>
    </div>
    <p class="m-0 mb-4 max-w-[620px] text-[13.5px] leading-[1.65] text-body md:mb-6 md:text-[14.5px]">
      Plugins are Luau, sandboxed, and add validation, column rules, menus and suggestions. Network
      access stays off until you switch it on.
    </p>

    <div class="grid grid-cols-1 gap-px border border-rule bg-rule md:grid-cols-3">
      {
        plugins.map((p) => (
          <div class="flex flex-col gap-3.5 bg-paper p-4 md:p-[22px] md:pb-6">
            <div class="flex items-center justify-between gap-3">
              <div
                class:list={[
                  'flex size-[30px] shrink-0 items-center justify-center text-sm font-bold tracking-[-0.02em] md:size-[38px] md:text-[17px]',
                  p.dark ? 'bg-ink text-paper' : 'text-ink',
                ]}
              >
                {p.mark}
              </div>
              <span
                class:list={[
                  'border border-[rgba(23,20,15,.24)] px-2 py-[3px] font-mono text-[9.5px] font-semibold uppercase tracking-[0.08em]',
                  p.tagClass,
                ]}
              >
                {p.tag}
              </span>
            </div>
            <div>
              <h3 class="m-0 mb-2 text-base font-semibold leading-[1.2] tracking-[-0.02em] md:text-[18px]">
                {p.name}
              </h3>
              <p class="m-0 text-[13px] leading-[1.6] text-body md:text-[13.5px]">{p.body}</p>
            </div>
            <div class="mt-auto border-t border-rule-nav pt-3 font-mono text-[11.5px] leading-[1.7] text-dim">
              {p.repo}
              <a href={p.href} class="block text-accent">
                {p.action}
              </a>
            </div>
          </div>
        ))
      }
    </div>
    <div class="mt-3.5 font-mono text-xs text-dim">
      One plugin published so far. The template carries type definitions for the whole plugin API.
    </div>
  </section>

  <section class="grid grid-cols-1 border-b border-rule md:grid-cols-2">
    <div class="gut border-b border-rule py-[26px] md:border-b-0 md:border-r md:px-[26px] md:py-[34px]">
      <div class="eyebrow mb-4 text-faint">The way it is now</div>
      <div class="flex flex-col gap-px border border-rule bg-rule">
        {
          mess.map(([file, note]) => (
            <div class="bg-paper px-3.5 py-[11px] font-mono text-[13px] text-body">
              {file} <span class="text-rust"> · {note}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="gut py-[26px] md:px-[26px] md:py-[34px]">
      <div class="eyebrow mb-4">The way it should be</div>
      <div class="border border-ink px-[18px] py-5 text-[13.5px] leading-[1.75] text-body">
        <div class="mb-3 font-mono text-[22px] font-semibold tracking-[-0.02em] text-ink">
          collection.qrate
        </div>
        Records, field definitions, authority lists, notes, validation state and the path to every
        linked file. Export to CSV, JSON-LD, CSL-JSON or a ZIP. Copy it, back it up, hand it to a
        colleague. It opens the same on every platform.
      </div>
    </div>
  </section>

  <!-- Not for a rich result. A Software App card needs ratings, which qrate has
       none of. This is for entity resolution: what qrate is, that it is free,
       and where the source lives, for search and for AI answers. -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'qrate',
      description:
        'One file holds the whole catalogue. A desktop editor for collection metadata, on macOS, Windows and Linux.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'macOS, Windows, Linux',
      softwareVersion: rel?.tag_name,
      url: 'https://qrate.dvnl.work',
      downloadUrl: 'https://qrate.dvnl.work/docs/install',
      codeRepository: `https://github.com/${REPO}`,
      license: 'https://www.gnu.org/licenses/agpl-3.0.html',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })}
  />
</Base>

<script is:inline define:vars={{ byOs, available }}>
  // Point the primary button at the visitor's own platform. Server-rendered
  // with the first available build, so this only ever swaps the label/href.
  (() => {
    if (!available.length) return;
    const ua = navigator.userAgent;
    const plat = navigator.userAgentData?.platform || navigator.platform || '';
    const hay = `${plat} ${ua}`;
    // Phones are checked first: an iPad reports "Mac", and no phone wants a .dmg.
    const guess = /iPhone|iPad|iPod|Android/i.test(hay)
      ? null
      : /Mac/i.test(hay)
        ? 'macOS'
        : /Win/i.test(hay)
          ? 'Windows'
          : /Linux|X11|CrOS/i.test(hay)
            ? 'Linux'
            : null;

    const primary = document.getElementById('dl-primary');
    const rest = document.getElementById('dl-others');

    // No build for this platform: point at the source instructions rather than
    // offering someone else's binary. Linux lands here until it ships assets.
    if (!byOs[guess]) {
      primary.href = '/docs/install#run-from-source';
      primary.textContent = 'Build from source';
      rest.textContent = available.join(' · ');
      return;
    }

    primary.href = byOs[guess];
    primary.textContent = `Download for ${guess}`;
    const others = available.filter((o) => o !== guess);
    rest.textContent = others.length ? others.join(' · ') : 'All platforms';
  })();
</script>

<script is:inline>
  // Light up the dot for whichever screen card the carousel has landed on.
  // Only the phone layout scrolls; on desktop the rail is a grid, scrollLeft
  // stays 0, and the dots are display:none anyway.
  (() => {
    const rail = document.getElementById('screen-rail');
    const dots = [...document.getElementById('screen-dots').children];
    const sync = () => {
      // Card pitch: the 300px basis plus the 12px gap.
      const i = Math.min(Math.round(rail.scrollLeft / 312), dots.length - 1);
      dots.forEach((d, n) => {
        d.style.width = n === i ? '18px' : '';
        d.style.background = n === i ? 'var(--accent)' : '';
      });
    };
    rail.addEventListener('scroll', sync, { passive: true });
    sync();
  })();
</script>

<script is:inline>
  // The hero caption names the theme the fake window is drawn in.
  (() => {
    const el = document.getElementById('theme-echo');
    const sync = () => {
      const hit = window.QRATE_THEMES.find(
        (t) => t[0] === document.documentElement.dataset.theme,
      );
      el.textContent = (hit || window.QRATE_THEMES[0])[1];
    };
    new MutationObserver(sync).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    sync();
  })();
</script>
