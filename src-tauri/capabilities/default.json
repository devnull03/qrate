{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main, projects, and settings windows",
	"windows": ["main", "projects", "settings"],
	"permissions": [
		"core:default",
		"core:window:default",
		"core:window:allow-start-dragging",
		"core:window:allow-close",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"opener:default",
		{
			"identifier": "opener:allow-open-path",
			"allow": [
				{
					"path": "**"
				}
			]
		},
		{
			"identifier": "opener:allow-reveal-item-in-dir",
			"allow": [
				{
					"path": "**"
				}
			]
		},
		"fs-pro:default",
		"dialog:default",
		"store:default"
	]
}
