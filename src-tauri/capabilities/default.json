{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main and projects windows",
	"windows": ["main", "projects"],
	"permissions": [
		"core:default",
		"core:window:default",
		"core:window:allow-start-dragging",
		"core:window:allow-close",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"opener:default",
		"fs-pro:default",
		"dialog:default"
	]
}
