{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrate-site",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],

  // The Astro Cloudflare adapter's entrypoint — it serves the one non-prerendered
  // route (/oauth/config). Static assets are matched before the Worker runs, so
  // every page is served straight from the edge with no invocation.
  "main": "@astrojs/cloudflare/entrypoints/server",

  "assets": {
    "binding": "ASSETS",
    // The adapter splits the build: dist/client is the static tree, dist/server
    // is the Worker.
    "directory": "./dist/client",
    // Astro emits get-started.html (build.format: 'file'), so /get-started is
    // served directly with no redirect.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
