{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrate",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],

  // The Astro Cloudflare adapter's entrypoint — it serves the non-prerendered
  // routes. Static assets are matched before the Worker runs.
  "main": "@astrojs/cloudflare/entrypoints/server",

  "assets": {
    "binding": "ASSETS",
    // The adapter splits the build: dist/client is the static tree, dist/server
    // is the Worker.
    "directory": "./dist/client",
    // Astro emits get-started.html (build.format: 'file'), so /get-started is
    // served directly with no redirect.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "kv_namespaces": [
    {
      "binding": "PLUGIN_CATALOG",
      "id": "7c353c741f4d4c4f8dbf6e93b069128b"
    }
  ],

  "ratelimits": [
    {
      "name": "FEEDBACK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true
  }
}
